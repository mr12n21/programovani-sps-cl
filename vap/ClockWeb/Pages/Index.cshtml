@page
@model ClockWeb.Pages.IndexModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aktualni cas</title>
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
            background: white;
            color: green;
        }

        main {
            text-align: center;
        }

        h1 {
            margin: 0 0 16px;
            font-size: 2rem;
        }

        .time {
            font-size: 4rem;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }
    </style>
</head>
<body>
    <main>
        <h1>Aktualni cas</h1>
        <div class="time" id="clock">@Model.InitialTime</div>
    </main>

    <script>
        const clock = document.getElementById("clock");

        async function refreshClock() {
            try {
                const response = await fetch("/api/time", { cache: "no-store" });

                if (!response.ok) {
                    return;
                }

                const data = await response.json();
                clock.textContent = data.currentTime;
            } catch {
            }
        }

        refreshClock();
        setInterval(refreshClock, 1000);
    </script>
</body>
</html>